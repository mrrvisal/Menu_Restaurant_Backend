# ─── Database ───────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=menu_restaurant
DB_CA_PATH=../ca.pem

# Automatically set by Render; leave empty for local development.
RENDER=

# ─── Server ────────────────────────────────────────────────
PORT=5001
NODE_ENV=development

# ─── JWT ─────────────────────────────────────────────────────
JWT_REFRESH_TTL=30d
JWT_ACCESS_TTL=24h

# ─── Secrets ─────────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_key_here
QR_SECRET=your_qr_encryption_secret_key_here

# ─── Sharing / link previews ───────────────────────────────
SHARE_ALLOWED_ORIGINS=

# ─── Frontend URL ─────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ─── Central Telegram Bot ───────────────────────────────────
TELEGRAM_BOT_TOKEN=your_central_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_central_telegram_chat_id_here

# ─── ImageKit ──────────────────────────────────────────────
IMAGEKIT_PUBLIC_KEY=your_public_key
IMAGEKIT_PRIVATE_KEY=your_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id

# ─── Email (Brevo API) ─────────────────────────────────────
BREVO_API_KEY=your_brevo_api_key
BREVO_FROM_NAME=Digital Menu
BREVO_FROM_EMAIL=noreply@example.com

# ─── Google Sign-In ─────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here.apps.googleusercontent.com

# ─── Web Push (VAPID) ───────────────────────────────────────
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=mailto:you@example.com