# ─── Database ───────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=menu_restaurant

# ─── ImageKit ──────────────────────────────────────────────
IMAGEKIT_PUBLIC_KEY=your_public_key
IMAGEKIT_PRIVATE_KEY=your_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id

# ─── Server ────────────────────────────────────────────────
PORT=5001
JWT_SECRET=your_jwt_secret_key_here
QR_SECRET=your_qr_encryption_secret_key_here
FRONTEND_URL=http://localhost:5173

# ─── Central Telegram Bot ───────────────────────────────────
# Create ONE bot via @BotFather, put its token here.
# Restaurant owners link their account to this bot via /link CODE.
TELEGRAM_BOT_TOKEN=your_central_telegram_bot_token_here

# ─── SMTP / Email (App Password) ────────────────────────────
# For Gmail: generate an App Password at https://myaccount.google.com/apppasswords
# (Requires 2FA enabled on your Google account)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your.email@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx   # 16-char app password (with spaces)
SMTP_FROM_NAME=Digital Menu
SMTP_FROM_EMAIL=your.email@gmail.com

# ─── SSL (only if using TiDB with SSL) ─────────────────────
DB_CA_PATH=../ca.pem

# ─── Google Sign-In ─────────────────────────────────────────
# Create an OAuth 2.0 Client ID (Web application) at https://console.cloud.google.com
# Add your frontend origins to "Authorized JavaScript origins":
#   http://localhost:5173 and your production URL (e.g. https://your-app.onrender.com)
# Setup guide: GOOGLE_SIGNIN_SETUP.md in the project root.
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here.apps.googleusercontent.com
